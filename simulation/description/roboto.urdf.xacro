<?xml version="1.0"?>
<!--
  Modele du robot Roboto pour Gazebo Harmonic.

  Les dimensions et les masses suivent la nomenclature reelle : roues de 85 mm de
  diametre, chassis d'environ 30 x 22 cm, RPLIDAR C1 a une quinzaine de centimetres du
  sol. Un modele qui ment sur ses dimensions produit une odometrie qui ment aussi, et le
  reglage fait en simulation ne vaut plus rien sur le robot reel.

  Les inerties sont calculees, pas devinees : un solide de revolution mal renseigne
  donne un robot qui derape ou qui vibre, et on passe des heures a chercher le probleme
  dans la commande.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboto">

  <!-- === Geometrie, d'apres la nomenclature ============================== -->

  <xacro:property name="wheel_radius" value="0.0425"/>   <!-- roues de 85 mm -->
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.15"/>
  <xacro:property name="wheel_separation" value="0.25"/>
  <xacro:property name="wheel_offset_x" value="0.08"/>

  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width" value="0.22"/>
  <xacro:property name="chassis_height" value="0.08"/>
  <!-- Chassis, calculateur, microcontroleur, driver et batterie. -->
  <xacro:property name="chassis_mass" value="2.6"/>

  <xacro:property name="caster_radius" value="0.02"/>
  <xacro:property name="caster_mass" value="0.05"/>
  <xacro:property name="caster_offset_x" value="-0.10"/>

  <xacro:property name="lidar_height" value="0.09"/>
  <!-- `pi` est fourni par xacro : le redefinir provoque un avertissement. -->
  <xacro:property name="half_turn" value="${pi / 2.0}"/>

  <!-- === Macros d'inertie ================================================= -->

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + length*length) / 12.0}" ixy="0.0" ixz="0.0"
        iyy="${mass * (3.0*radius*radius + length*length) / 12.0}" iyz="0.0"
        izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${2.0 * mass * radius * radius / 5.0}" ixy="0.0" ixz="0.0"
        iyy="${2.0 * mass * radius * radius / 5.0}" iyz="0.0"
        izz="${2.0 * mass * radius * radius / 5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- === Chassis ========================================================== -->

  <!-- Repere projete au sol, sous l'axe des roues. Nav2 et la pile TF s'y attendent. -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + 0.02}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.25 0.27 0.30 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="${chassis_mass}"
                       x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <!-- === Roues motrices =================================================== -->

  <xacro:macro name="drive_wheel" params="prefix side">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${half_turn} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.08 0.08 0.08 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${half_turn} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${wheel_mass}"
                              radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_offset_x} ${side * wheel_separation / 2.0} -0.02" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <!-- Adherence franche : une roue motrice qui patine fausse l'odometrie. -->
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" side="1"/>
  <xacro:drive_wheel prefix="right" side="-1"/>

  <!-- === Roulette folle =================================================== -->

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia mass="${caster_mass}" radius="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_offset_x} 0 ${caster_radius - wheel_radius - 0.02}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <!-- Frottement quasi nul : la roulette porte, elle ne dirige pas. -->
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- === LiDAR ============================================================ -->

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.3 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.19" radius="0.035" length="0.04"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 ${lidar_height}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <!-- En Harmonic il n'existe pas de LiDAR CPU : `gpu_lidar` passe par le pipeline
         de rendu, d'ou le rendu logiciel dans l'image de simulation. -->
    <sensor name="lidar" type="gpu_lidar">
      <topic>/roboto/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <!-- Caracteristiques du RPLIDAR C1 : 12 m de portee, 5 cm de zone aveugle. -->
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- === Centrale inertielle ============================================== -->

  <link name="imu_link">
    <xacro:box_inertia mass="0.01" x="0.02" y="0.02" z="0.005"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/roboto/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- === Camera =========================================================== -->

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.02"/>
      </geometry>
      <material name="camera_dark">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <xacro:box_inertia mass="0.05" x="0.02" y="0.06" z="0.02"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length / 2.0} 0 0.02" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>/roboto/camera</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- === Systemes Gazebo ================================================== -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <!-- Le robot simule n'ecoute que `/roboto/cmd_vel`, sur lequel le pont ne
           recopie que la sortie post-securite du coeur. Il n'existe donc aucun chemin
           permettant de piloter les roues en contournant `robot-safety`. -->
      <topic>/roboto/cmd_vel</topic>
      <odom_topic>/roboto/odom</odom_topic>
      <tf_topic>/roboto/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/roboto/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
